<View>
  <Header name="title" value="OCR Benchmark Line" style="color: #111111;" />
  <View
    style="padding: 10px; margin-bottom: 12px; border: 1px solid #d0d0d0; background-color: #f5f5f5; color: #111111;"
  >
    <Text
      name="meta_line"
      style="color: #111111; font-weight: 600;"
      value="Doc: $doc_stem | Page: $page_id | Lang: $lang | Split: $split_hint | Line: $line_id"
    />
  </View>

  <Image name="image" value="$image" zoom="true" zoomControl="true" />

  <TextArea
    name="transcription"
    toName="image"
    value="$transcription_seed"
    editable="true"
    maxSubmissions="1"
    rows="3"
    placeholder="Correct the OCR text here"
  />
</View>
